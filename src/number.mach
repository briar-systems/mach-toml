# numeric literals: decimal, float, hex, octal and binary integers

use std.memory;
use std.types.bool.bool;
use std.types.bool.false;
use std.types.bool.true;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use toml.error.TomlError;
use toml.scan.hex_digit;
use toml.value.Value;
use toml.value.value_fail;
use toml.value.value_float;
use toml.value.value_int;
use toml.value.value_ok;

# parse an integer or float value
# handles decimal, hex, octal, binary integers, decimal floats with
# optional exponent, and special values inf/nan.
# ---
# src: source text
# i:   cursor position
# ret: parsed Value, or the failure
pub fun parse_number(src: str, i: *usize) res[Value, TomlError] {
    val at_:  usize = @i;
    var sign: i64   = 1;
    if (src[@i] == '+') { @i = @i + 1; }
    or (src[@i] == '-') {
        sign = -1;
        @i   = @i + 1;
    }

    # inf
    if (src[@i] == 'i' && src[@i + 1] == 'n' && src[@i + 2] == 'f') {
        @i = @i + 3;
        var bits: u64 = 0x7FF0000000000000;
        if (sign < 0) { bits = 0xFFF0000000000000; }
        var inf_val: f64;
        memory.raw_copy(?inf_val, ?bits, 8);
        ret value_ok(value_float(inf_val));
    }

    # nan
    if (src[@i] == 'n' && src[@i + 1] == 'a' && src[@i + 2] == 'n') {
        @i = @i + 3;
        var bits: u64 = 0x7FF8000000000000;
        if (sign < 0) { bits = 0xFFF8000000000000; }
        var nan_val: f64;
        memory.raw_copy(?nan_val, ?bits, 8);
        ret value_ok(value_float(nan_val));
    }

    # hex, octal, binary prefixes
    if (src[@i] == '0') {
        val next: u8 = src[@i + 1];
        if (next == 'x' || next == 'X') {
            @i = @i + 2;
            ret parse_hex_int(src, i, sign, at_);
        }
        if (next == 'o' || next == 'O') {
            @i = @i + 2;
            ret parse_oct_int(src, i, sign, at_);
        }
        if (next == 'b' || next == 'B') {
            @i = @i + 2;
            ret parse_bin_int(src, i, sign, at_);
        }
    }

    # decimal integer or float
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '9') { brk; }
        any = true;
        val digit:          u64 = (b - '0')::u64;
        val max_before_mul: u64 = 18446744073709551615 / 10;
        if (x > max_before_mul) { ret value_fail(TomlError.overflow{at_}); }
        val nx: u64 = x * 10;
        if (digit > 18446744073709551615 - nx) { ret value_fail(TomlError.overflow{at_}); }
        x  = nx + digit;
        @i = @i + 1;
    }

    if (!any) { ret value_fail(TomlError.syntax{@i}); }

    # fractional part
    if (src[@i] == '.' && src[@i + 1] >= '0' && src[@i + 1] <= '9') {
        ret parse_float_frac(src, i, x::i64, sign);
    }

    # exponent without fraction
    if (src[@i] == 'e' || src[@i] == 'E') {
        ret parse_float_exp(src, i, x::f64 * sign::f64);
    }

    ret value_ok(value_int(x::i64 * sign));
}

# parse the fractional part of a float after the '.'
# ---
# src:      source text
# i:        cursor position (on the '.')
# int_part: integer digits already parsed
# sign:     1 or -1
# ret:      parsed float Value, or the failure
fun parse_float_frac(src: str, i: *usize, int_part: i64, sign: i64) res[Value, TomlError] {
    @i = @i + 1;
    var frac:    f64 = 0.0;
    var divisor: f64 = 1.0;

    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '9') { brk; }
        frac    = frac * 10.0 + (b - '0')::u64::f64;
        divisor = divisor * 10.0;
        @i      = @i + 1;
    }

    var result: f64 = (int_part::f64 + frac / divisor) * sign::f64;

    if (src[@i] == 'e' || src[@i] == 'E') {
        ret parse_float_exp(src, i, result);
    }

    ret value_ok(value_float(result));
}

# parse the exponent part of a float after 'e'/'E'
# ---
# src:      source text
# i:        cursor position (on the 'e' or 'E')
# mantissa: value accumulated so far
# ret:      parsed float Value, or the failure
fun parse_float_exp(src: str, i: *usize, mantissa: f64) res[Value, TomlError] {
    @i = @i + 1;
    var exp_sign: i64 = 1;
    if (src[@i] == '+') { @i = @i + 1; }
    or (src[@i] == '-') {
        exp_sign = -1;
        @i       = @i + 1;
    }

    var exp: i64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '9') { brk; }
        any = true;
        exp = exp * 10 + (b - '0')::u64::i64;
        @i  = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }

    var result: f64 = mantissa;
    result = apply_pow10(result, exp, exp_sign);

    ret value_ok(value_float(result));
}

# multiply or divide value by 10^exp using a lookup table
fun apply_pow10(value: f64, exp: i64, exp_sign: i64) f64 {
    var pow10: [20]f64;
    pow10[0]  = 1.0;
    pow10[1]  = 10.0;
    pow10[2]  = 100.0;
    pow10[3]  = 1000.0;
    pow10[4]  = 10000.0;
    pow10[5]  = 100000.0;
    pow10[6]  = 1000000.0;
    pow10[7]  = 10000000.0;
    pow10[8]  = 100000000.0;
    pow10[9]  = 1000000000.0;
    pow10[10] = 10000000000.0;
    pow10[11] = 100000000000.0;
    pow10[12] = 1000000000000.0;
    pow10[13] = 10000000000000.0;
    pow10[14] = 100000000000000.0;
    pow10[15] = 1000000000000000.0;
    pow10[16] = 10000000000000000.0;
    pow10[17] = 100000000000000000.0;
    pow10[18] = 1000000000000000000.0;
    pow10[19] = 10000000000000000000.0;

    var result:    f64 = value;
    var remaining: i64 = exp;
    for (remaining > 0) {
        var chunk: i64 = remaining;
        if (chunk > 19) { chunk = 19; }
        if (exp_sign > 0) {
            result = result * pow10[chunk::usize];
        }
        or {
            result = result / pow10[chunk::usize];
        }
        remaining = remaining - chunk;
    }
    ret result;
}

# parse hexadecimal digits into an integer value
fun parse_hex_int(src: str, i: *usize, sign: i64, at_: usize) res[Value, TomlError] {
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        val d: i32 = hex_digit(b);
        if (d < 0) { brk; }
        any = true;
        if (x > 0x0FFFFFFFFFFFFFFF) { ret value_fail(TomlError.overflow{at_}); }
        x  = (x << 4) | d::u32::u64;
        @i = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }
    ret value_ok(value_int(x::i64 * sign));
}

# parse octal digits into an integer value
fun parse_oct_int(src: str, i: *usize, sign: i64, at_: usize) res[Value, TomlError] {
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b < '0' || b > '7') { brk; }
        any = true;
        if (x > 0x1FFFFFFFFFFFFFFF) { ret value_fail(TomlError.overflow{at_}); }
        x  = (x << 3) | (b - '0')::u64;
        @i = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }
    ret value_ok(value_int(x::i64 * sign));
}

# parse binary digits into an integer value
fun parse_bin_int(src: str, i: *usize, sign: i64, at_: usize) res[Value, TomlError] {
    var x:   u64  = 0;
    var any: bool = false;
    for {
        val b: u8 = src[@i];
        if (b == '_') {
            @i = @i + 1;
            cnt;
        }
        if (b != '0' && b != '1') { brk; }
        any = true;
        if (x > 0x7FFFFFFFFFFFFFFF) { ret value_fail(TomlError.overflow{at_}); }
        x  = (x << 1) | (b - '0')::u64;
        @i = @i + 1;
    }
    if (!any) { ret value_fail(TomlError.syntax{@i}); }
    ret value_ok(value_int(x::i64 * sign));
}
