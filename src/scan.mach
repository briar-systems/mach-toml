# byte classes, and skipping whitespace, newlines and comments

use std.types.bool.bool;
use std.types.size.usize;
use std.types.string.str;

fun is_ws(b: u8) bool {
    ret b == ' ' || b == '\t';
}

pub fun is_ws_or_newline(b: u8) bool {
    ret b == ' ' || b == '\t' || b == '\n' || b == '\r';
}

pub fun is_bare_key_char(b: u8) bool {
    ret (b >= 'A' && b <= 'Z')
        || (b >= 'a' && b <= 'z')
        || (b >= '0' && b <= '9')
        || b == '_' || b == '-';
}

pub fun skip_ws(src: str, i: *usize) {
    for (is_ws(src[@i])) {
        @i = @i + 1;
    }
}

fun skip_ws_and_newlines(src: str, i: *usize) {
    for (is_ws_or_newline(src[@i])) {
        @i = @i + 1;
    }
}

fun skip_comment(src: str, i: *usize) {
    if (src[@i] == '#') {
        for (src[@i] != 0 && src[@i] != '\n') {
            @i = @i + 1;
        }
    }
}

pub fun skip_ws_comments_newlines(src: str, i: *usize) {
    for {
        skip_ws_and_newlines(src, i);
        if (src[@i] == '#') {
            skip_comment(src, i);
            cnt;
        }
        brk;
    }
}

pub fun skip_to_newline(src: str, i: *usize) {
    skip_ws(src, i);
    skip_comment(src, i);
    if (src[@i] == '\r') { @i = @i + 1; }
    if (src[@i] == '\n') { @i = @i + 1; }
}

# return the numeric value of a hex character, or -1
pub fun hex_digit(c: u8) i32 {
    if (c >= '0' && c <= '9') { ret (c - '0')::u32::i32; }
    if (c >= 'a' && c <= 'f') { ret (c - 'a')::u32::i32 + 10; }
    if (c >= 'A' && c <= 'F') { ret (c - 'A')::u32::i32 + 10; }
    ret -1;
}

# check if a byte terminates a bare value
pub fun is_value_term(b: u8) bool {
    ret b == 0 || b == ' ' || b == '\t' || b == '\n' || b == '\r'
        || b == ',' || b == ']' || b == '}' || b == '#';
}
