# the value model a parse builds: tagged values, tables and arrays

use std.types.bool.bool;
use std.types.result.res;
use std.types.size.usize;
use std.types.string.str;
use toml.error.TomlError;

pub val TYPE_STRING:  u8 = 0;
pub val TYPE_INTEGER: u8 = 1;
pub val TYPE_FLOAT:   u8 = 2;
pub val TYPE_BOOL:    u8 = 3;
pub val TYPE_ARRAY:   u8 = 4;
pub val TYPE_TABLE:   u8 = 5;

# a byte range of the document handed to `parse`
# ---
# at:  offset of the first byte, as `TomlError` positions its failures
# len: byte count; a span of length 0 at offset 0 means "not parsed"
pub rec Span {
    at:  usize;
    len: usize;
}

# tagged TOML value
#
# a parsed value records where it came from. `span` is the literal as written:
# the quotes of a string, the brackets of an array or inline table, the whole
# `[header]` or `[[header]]` line for a table a header defined, or the key token
# that created a table implicitly (a dotted key's inner segment, a header's
# inner segment). `key` is the key token that maps to this value in its table,
# the last segment of a dotted key as written, quotes included. an array
# element has no key of its own and carries the `[[header]]`'s final segment
# when a header appended it, else the zero span. a value not produced by
# `parse` carries the zero span in both.
# ---
# tag:  type discriminator (TYPE_*)
# span: the value's literal in the source
# key:  the key token that maps to it
pub rec Value {
    tag:  u8;
    span: Span;
    key:  Span;
    data: uni {
        string: str;
        integer: i64;
        float: f64;
        boolean: bool;
        array: Array;
        table: Table;
    };
}

# ordered list of TOML values
# ---
# items: pointer to Value array (ptr to break recursion)
# len:   number of elements
# cap:   allocated capacity
pub rec Array {
    items: ptr;
    len:   usize;
    cap:   usize;
}

# ordered map of string keys to TOML values
#
# a key's source position lives on the value it maps to (`Value.key`), so one
# `get` answers both where the key and where its value were written.
# ---
# keys:   pointer to str array (parallel with values)
# values: pointer to Value array
# len:    number of entries
# cap:    allocated capacity
pub rec Table {
    keys:   ptr;
    values: ptr;
    len:    usize;
    cap:    usize;
}

# create an empty table with nil backing storage
pub fun table_make() Table {
    var t: Table;
    t.keys   = nil;
    t.values = nil;
    t.len    = 0;
    t.cap    = 0;
    ret t;
}

# create an empty array with nil backing storage
pub fun array_make() Array {
    var a: Array;
    a.items = nil;
    a.len   = 0;
    a.cap   = 0;
    ret a;
}

# the zero span: not parsed
fun span_none() Span {
    var sp: Span;
    sp.at  = 0;
    sp.len = 0;
    ret sp;
}

# the bytes from `start` to the cursor
pub fun span_from(start: usize, end: usize) Span {
    var sp: Span;
    sp.at  = start;
    sp.len = end - start;
    ret sp;
}

pub fun value_string(s: str) Value {
    var v: Value;
    v.tag         = TYPE_STRING;
    v.span        = span_none();
    v.key         = span_none();
    v.data.string = s;
    ret v;
}

pub fun value_int(n: i64) Value {
    var v: Value;
    v.tag          = TYPE_INTEGER;
    v.span         = span_none();
    v.key          = span_none();
    v.data.integer = n;
    ret v;
}

pub fun value_float(f: f64) Value {
    var v: Value;
    v.tag        = TYPE_FLOAT;
    v.span       = span_none();
    v.key        = span_none();
    v.data.float = f;
    ret v;
}

pub fun value_bool(b: bool) Value {
    var v: Value;
    v.tag          = TYPE_BOOL;
    v.span         = span_none();
    v.key          = span_none();
    v.data.boolean = b;
    ret v;
}

pub fun value_table(t: Table) Value {
    var v: Value;
    v.tag        = TYPE_TABLE;
    v.span       = span_none();
    v.key        = span_none();
    v.data.table = t;
    ret v;
}

pub fun value_array(a: Array) Value {
    var v: Value;
    v.tag        = TYPE_ARRAY;
    v.span       = span_none();
    v.key        = span_none();
    v.data.array = a;
    ret v;
}

pub fun value_fail(e: TomlError) res[Value, TomlError] {
    ret res[Value, TomlError].err{e};
}

pub fun value_ok(v: Value) res[Value, TomlError] {
    ret res[Value, TomlError].ok{v};
}
